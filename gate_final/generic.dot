digraph "all_gate" {
label="all_gate";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="a", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="and1", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="b", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="nand1", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="nor1", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="or1", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="xnor1", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="xor1", color="black", fontcolor="black" ];
c12 [ shape=record, label="{{<p9> A|<p10> B}|$61\n$_OR_|{<p11> Y}}" ];
c13 [ shape=record, label="{{<p9> A|<p10> B}|$62\n$_NOR_|{<p11> Y}}" ];
