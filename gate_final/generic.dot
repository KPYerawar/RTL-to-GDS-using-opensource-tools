c17 [ shape=record, label="{{<p9> A|<p10> B}|$66\n$_XNOR_|{<p11> Y}}" ];
n1:e -> c12:p10:w [color="black", label=""];
n1:e -> c13:p10:w [color="black", label=""];
n1:e -> c14:p10:w [color="black", label=""];
n1:e -> c15:p10:w [color="black", label=""];
n1:e -> c16:p10:w [color="black", label=""];
