VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN all_gate ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 50000 50000 ) ;
ROW ROW_0 unithd 5060 5440 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 5060 8160 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 5060 10880 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 5060 13600 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 5060 16320 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 5060 19040 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_6 unithd 5060 21760 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_7 unithd 5060 24480 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_8 unithd 5060 27200 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_9 unithd 5060 29920 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_10 unithd 5060 32640 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_11 unithd 5060 35360 FS DO 86 BY 1 STEP 460 0 ;
ROW ROW_12 unithd 5060 38080 N DO 86 BY 1 STEP 460 0 ;
ROW ROW_13 unithd 5060 40800 FS DO 86 BY 1 STEP 460 0 ;
TRACKS X 230 DO 109 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 147 STEP 340 LAYER li1 ;
TRACKS X 170 DO 147 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 147 STEP 340 LAYER met1 ;
TRACKS X 230 DO 109 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 109 STEP 460 LAYER met2 ;
TRACKS X 340 DO 73 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 73 STEP 680 LAYER met3 ;
TRACKS X 460 DO 54 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 54 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 14 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 14 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 7 STEP 6900 ;
GCELLGRID Y 0 DO 7 STEP 6900 ;
COMPONENTS 6 ;
    - _08_ sky130_fd_sc_hd__nor2_1 + PLACED ( 26680 8160 ) FS ;
    - _09_ sky130_fd_sc_hd__lpflow_inputiso1p_1 + PLACED ( 22080 5440 ) N ;
    - _10_ sky130_fd_sc_hd__and2_0 + PLACED ( 21160 10880 ) N ;
    - _11_ sky130_fd_sc_hd__nand2_1 + PLACED ( 23460 10880 ) N ;
    - _12_ sky130_fd_sc_hd__xor2_1 + PLACED ( 23460 8160 ) FS ;
    - _13_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 20240 8160 ) FS ;
END COMPONENTS
PINS 8 ;
    - a + NET a + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 27830 242 ) N ;
    - and1 + NET _01_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 21390 242 ) N ;
    - b + NET b + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 24150 242 ) N ;
    - nand1 + NET _03_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 25070 242 ) N ;
    - nor1 + NET _04_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 26910 242 ) N ;
    - or1 + NET _05_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 23230 242 ) N ;
    - xnor1 + NET _06_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 22310 242 ) N ;
    - xor1 + NET _07_ + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 25990 242 ) N ;
END PINS
SPECIALNETS 2 ;
    - VDD + USE POWER ;
    - VSS + USE GROUND ;
END SPECIALNETS
NETS 8 ;
    - _01_ ( PIN and1 ) ( _10_ X ) + USE SIGNAL
      + ROUTED met2 ( 21390 340 0 ) ( * 11390 )
      NEW met1 ( 21390 11390 ) ( 23230 * )
      NEW met1 ( 21390 11390 ) M1M2_PR
      NEW li1 ( 23230 11390 ) L1M1_PR_MR ;
    - _03_ ( PIN nand1 ) ( _11_ Y ) + USE SIGNAL
      + ROUTED met2 ( 25070 340 0 ) ( * 11390 )
      NEW met1 ( 24610 11390 ) ( 25070 * )
      NEW met1 ( 25070 11390 ) M1M2_PR
      NEW li1 ( 24610 11390 ) L1M1_PR_MR ;
