      NEW met1 ( 22310 8670 ) ( 22770 * )
      NEW met1 ( 22310 8670 ) M1M2_PR
      NEW li1 ( 22770 8670 ) L1M1_PR_MR ;
    - _07_ ( PIN xor1 ) ( _12_ X ) + USE SIGNAL
